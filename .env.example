# Copy to .env. Never commit credentials.
EPAPERS_DATA_DIR=.local/data
# HA URL and token can be saved in Web UI > 设置; leave these blank when using Web UI.
EPAPERS_HA_URL=
EPAPERS_HA_TOKEN=
EPAPERS_API_TOKEN=
EPAPERS_TIMEZONE=Asia/Shanghai
EPAPERS_GATEWAY_TOKEN=
# Demo runs only when explicitly enabled; simulated devices are labelled in UI.
EPAPERS_DEMO=false
